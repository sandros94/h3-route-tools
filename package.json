{
  "name": "h3-route-tools",
  "version": "0.1.1",
  "description": "Experimental library to generate typed routes for H3",
  "keywords": [
    "h3",
    "nitro",
    "openapi",
    "routes",
    "standard-schema",
    "type-safe",
    "typed-fetch",
    "typescript",
    "validation"
  ],
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sandros94/h3-route-tools.git"
  },
  "bin": {
    "h3-route-tools": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.mts",
      "import": "./dist/openapi/index.mjs"
    },
    "./codegen": {
      "types": "./dist/codegen.d.mts",
      "import": "./dist/codegen.mjs"
    },
    "./nitro": {
      "types": "./dist/nitro.d.mts",
      "import": "./dist/nitro.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "stub": "obuild --stub",
    "dev:h3": "pnpm -F playground-h3 dev",
    "dev:vue": "pnpm -F playground-nitro-vue dev",
    "dev:prepare": "obuild --stub && pnpm simple-git-hooks",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "typecheck:playgrounds": "pnpm -F playground-nitro-vue typecheck",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^24",
    "@valibot/to-json-schema": "^1.7.1",
    "@vitest/coverage-v8": "^4.1.10",
    "nitro": "^3.0.260610-beta",
    "obuild": "^0.4.38",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "~7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~7.0.2",
    "valibot": "^1.4.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "h3": ">=2.0.1-rc.25 || ^2.0.1",
    "nitro": ">=3.0.1",
    "srvx": "^0.11.22",
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "resolutions": {
    "h3-route-tools": "link:."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm stub && pnpm lint && pnpm typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.15.1"
}
